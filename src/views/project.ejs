<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    <p><strong>Categories:</strong>
        <% if (categories && categories.length) { %>
            <% categories.forEach((category, index) => { %><a href="/category/<%= category.category_id %>"><%= category.category_name %></a><% if (index < categories.length - 1) { %>, <% } %><% }); %>
        <% } else { %>
            None listed
        <% } %>
    </p>
</main>
<p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
<%- include('partials/footer') %>
