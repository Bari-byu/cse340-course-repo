<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <ul>
        <% categories.forEach(category => { %>
            <li><strong><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></strong></li>
        <% }); %>
    </ul>

    <p><a href="/new-category">Add a New Category</a></p>
</main>

<%- include('partials/footer') %>